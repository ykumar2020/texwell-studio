                 {\usefont}{Force font face}%
\DeclareRobustCommand\usefont[4]{\fontencoding{#1}%
   \edef\f@family{#2}%
   \set@target@series{#3}%
   \edef\f@shape{#4}%
   \let\delayed@f@adjustment\@empty
   \selectfont
   \ignorespaces}
\EndIncludeInRelease
