                 {\@flcheckspace}{float placement calculation}%
\def \@flcheckspace #1#2{%
   \@reqcolroom \saved@reqcolroom
   \advance \@reqcolroom
     \ifx #2\@empty \textfloatsep \else \floatsep \fi
   \ifdim \@colroom>\@reqcolroom
     \ifdim #1>\ht\@currbox
       \@tempswatrue
     \else
       \ifnum \@fpstype<\sixt@@n
         \@tempswatrue
       \fi
     \fi
   \fi
}
\EndIncludeInRelease
\IncludeInRelease{0000/00/00}%
