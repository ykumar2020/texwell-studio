    \special{#2="#1"\GPT@space
      \ifx\Gin@page\@empty\else page=\Gin@page\GPT@space\fi
      llx=\Gin@llx\GPT@space
      lly=\Gin@lly\GPT@space
      urx=\Gin@urx\GPT@space
      ury=\Gin@ury\GPT@space
