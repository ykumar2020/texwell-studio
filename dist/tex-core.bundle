  \Gin@req@width0.99626\Gin@req@width%
  \Gin@req@height0.99626\Gin@req@height%
  \raise\strip@pt\Gin@req@height bp\hbox{%
    \special{dvisvgm: raw
      <g transform="translate({?x},{?y})">%
