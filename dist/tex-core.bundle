\ifx\@currext\@clsextension
    \typeout{Document Class: \@gtempa\space#1}%
  \else
    \protected@wlog{Package: \@gtempa\space#1}%   <--- protected
  \fi}

\EndIncludeInRelease
\IncludeInRelease{0000/00/00}%
