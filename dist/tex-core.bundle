    {<->ssub*cmss/m/sl}{}
\DeclareFontShape{U}{cmss}{m}{sl}%
    {%
      <5><6><7><8>cmssi8<9>cmssi9%
      <10><10.95>cmssi10%
      <12><14.4>cmssi12%
      <17.28><20.74><24.88>cmssi17%
      }{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{U}{cmss}{m}{sc}%
       {<->sub*cmr/m/sc}{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{U}{cmss}{m}{ui}%
       {<->sub*cmr/m/ui}{}
%%%%%%%% semibold condensed series
