          \edef\OutputFile{\ETE@GenerateName{\Gin@base}{#2}}%
        \else
          \begingroup
            \filename@parse{\Gin@base#2}%
            \edef\x{\endgroup
              \def\noexpand\OutputFile{%
                \ETE@GenerateName{%
                  \OutputDirectory\filename@base
