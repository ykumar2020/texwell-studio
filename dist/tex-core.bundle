\def\@makefcolumn #1{%
  \begingroup
    \@fpmin \z@
    \let \@testfp \@gobble
    \@tryfcolumn #1%
  \endgroup
  \if@fcolmade
    \fl@trace{PAGE: in \string\clearpage
                    \if@twocolumn ---twocolumn\fi---}%
    \fl@trace{----- float column/page completed
                    from \string#1}%
  \fi
}
\EndIncludeInRelease
