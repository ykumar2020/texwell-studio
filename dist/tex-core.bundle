       \ifnum \@fpstype<\sixt@@n
         \fl@trace{ERROR: !t float not successful
                                        (addtodblcol)}%
       \fi
     \fi
   \fi
   \if@insert
   \else
     \fl@trace{put on dbldeferlist}%
     \@cons\@dbldeferlist\@currbox
