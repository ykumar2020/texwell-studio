\def\ETE@Gin@setfile#1#2#3{%
  \ifETE@disable
    \ETE@OrgGin@setfile{#1}{#2}{#3}%
  \else
    \begingroup
      \ETE@InsideSetfiletrue
      \ETE@DefX{#3}%
    \expandafter\endgroup
    \ifx\x\@empty
      \ETE@OrgGin@setfile{#1}{#2}{#3}%
    \else
      \begingroup
        \ETE@InsideSetfiletrue
        \def\GraphicsType{#1}%
        \def\GraphicsRead{#2}%
        \ifETE@prefersuffix
        \else
          \ifx\ETE@suffix\@empty
          \else
            \ETE@IfFileExists{\Gin@base\GraphicsRead}{%
              \ETE@Skip{%
                \ETE@OrgGin@setfile{#1}{#2}{\Gin@base#2}%
