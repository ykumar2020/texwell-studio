 \ifcat\noexpand\@let@token0\else
 \ifcat\noexpand\@let@token\relax\else
 \let\@let@token@\at@@@\fi\fi\fi\next@}
\def\at@@#1{\expandafter
  \@ifundefined{ @\string#1}%
    {\DN@{\at@@@#1}}%
    {\DN@{\csname\space @\string#1\endcsname}}%
  \next@}%
