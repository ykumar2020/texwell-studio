\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{texwell-booktabs}[2026/10/23 v0.1 TeXwell table rules]
\newdimen\heavyrulewidth \newdimen\lightrulewidth \newdimen\cmidrulewidth
\heavyrulewidth=.08em \lightrulewidth=.05em \cmidrulewidth=.03em
\newcommand\toprule{\noalign{\vskip .65ex}\hline\noalign{\vskip .4ex}}
\newcommand\midrule{\noalign{\vskip .4ex}\hline\noalign{\vskip .4ex}}
\newcommand\bottomrule{\noalign{\vskip .4ex}\hline\noalign{\vskip .65ex}}
\newcommand\specialrule[3]{\noalign{\vskip #2\hrule height #1\vskip #3}}
\newcommand\addlinespace[1][.5ex]{\noalign{\vskip #1}}
\newcommand\cmidrule[1]{\cline{#1}}
